extends: relaxed

rules:
  # Long lines are fine: the vendored CRDs, the Helm output and the
  # Flux-generated manifests are not ours to reformat.
  line-length: disable

ignore: |
  # Generated by `flux install` — do not edit.
  flux/flux-system/gotk-components.yaml
  # Vendored verbatim from kubernetes-sigs/gateway-api — do not edit.
  flux/gateway-api/crds/
  # Decrypted Talos machine configs (gitignored working copies produced by
  # talos/scripts/gen-configs.sh) — output of `talosctl gen config`, not ours
  # to reformat.
  talos/controlplane.yaml
  talos/worker.yaml
